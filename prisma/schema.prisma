// Prisma schema for Student Attendance System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Student {
  id                     String   @id @default(cuid())
  studentId              String   @unique // Roll number
  name                   String
  branch                 String
  section                String
  semester               Int
  passwordHash           String
  passwordPlain          String   @default("") // visible to admin so they can share with student
  email                  String?
  phone                  String?
  // Browser fingerprint hash to enforce one-device-per-student
  deviceFingerprint      String?
  deviceRegisteredAt     DateTime?
  // Whether the student has seen the one-time onboarding screen (device status)
  hasSeenOnboarding      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  attendances Attendance[]
  qrScans    QRScan[]
  teamMembers TeamMember[]
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  branch      String
  semester    Int
  totalClasses Int     @default(0) // total classes conducted so far
  createdAt   DateTime @default(now())

  attendances Attendance[]
  resources   Resource[]
  qrSessions  QRSession[]
  qrScans     QRScan[]
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  subjectId   String
  date        DateTime // the class date
  status      String   // "Present" | "Absent"
  markedBy    String   // admin id
  markedVia   String   @default("manual") // manual | biometric
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date])
}

model DeviceRegistration {
  id                String   @id @default(cuid())
  studentId         String
  deviceFingerprint String
  userAgent         String
  registeredAt      DateTime @default(now())

  @@unique([studentId]) // one device per student
}

// Free study resources linked to subjects (videos, PDFs, courses, articles)
model Resource {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  type        String   // "video" | "pdf" | "course" | "article" | "book"
  url         String
  description String?
  isFree      Boolean  @default(true)
  createdAt   DateTime @default(now())

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// QR attendance sessions generated by admin — students scan + verify face to mark attendance
model QRSession {
  id         String   @id @default(cuid())
  token      String   @unique // the QR code payload
  subjectId  String
  date       DateTime // class date
  createdBy  String   // admin id
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scans      QRScan[]
}

// Each successful QR attendance scan (one per student per session)
model QRScan {
  id          String   @id @default(cuid())
  qrSessionId String
  studentId   String
  subjectId   String
  date        DateTime
  faceVerified Boolean @default(true)
  capturedPhotoHash String? // hash of captured photo (privacy)
  createdAt   DateTime @default(now())

  qrSession   QRSession @relation(fields: [qrSessionId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([qrSessionId, studentId]) // one scan per student per QR session
}

// Audit log of sensitive admin actions — for security forensics
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   // who performed the action (admin id, student id, or "anonymous")
  actorRole String   // "admin" | "student" | "system"
  action    String   // e.g. "student.create", "student.delete", "attendance.mark", "device.unbind", "auth.login.success", "auth.login.failed"
  target    String?  // affected entity id (student id, subject id, etc.)
  ip        String?
  userAgent String?
  details   String?  // JSON-stringified extra context
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// Failed login attempts — for rate limiting + brute-force detection
model FailedLoginAttempt {
  id        String   @id @default(cuid())
  username  String   // the username/roll-no that was attempted
  role      String   // "admin" | "student"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([username])
  @@index([ip])
  @@index([createdAt])
}

// ============================================================================
// JAVA PROJECT SUBMISSION PORTAL — models for team formation, topic selection,
// progressive reviews (R0/R1/R2), marking rubrics, and live support sessions.
// ============================================================================

// A project team — 3-4 students + a faculty mentor.
model Team {
  id              String   @id @default(cuid())
  teamName        String   @unique
  facultyMentorId String
  status          String   @default("forming") // "forming" | "finalized" | "locked"
  batch           String   @default("2029")
  createdAt       DateTime @default(now())
  finalizedAt     DateTime?

  members         TeamMember[]
  invitations     TeamInvitation[]
  reviewSubmissions ReviewSubmission[]

  @@index([facultyMentorId])
  @@index([status])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  studentId String
  role      String   // "Leader" | "Member"
  addedAt   DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentId])
  @@index([studentId])
}

model TeamInvitation {
  id              String   @id @default(cuid())
  teamId          String
  leaderStudentId String
  inviteeEmail    String
  inviteeStudentId String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  respondedAt     DateTime?

  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([inviteeEmail])
}

model PresetTopic {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("General")
  createdAt   DateTime @default(now())

  @@index([category])
}

// Review submission — includes presentationUrl (PDF/PPT) + codeUrl (GitHub)
// per the official submission guidelines.
model ReviewSubmission {
  id              String   @id @default(cuid())
  teamId          String
  reviewNumber    Int      // 0, 1, or 2
  // R0 fields
  projectTitle    String?
  projectDescription String?
  proposedTopic   Boolean  @default(false)
  // R1 + R2 fields — per guidelines: presentation file + GitHub link + report
  presentationUrl String? // PDF or PPT file link (Google Drive / direct URL)
  reportUrl       String? // Written report URL
  codeUrl         String? // GitHub repository URL (must be public)
  demoUrl         String? // Optional live demo URL
  rubricType      String?  // "A" (GUI) | "B" (Web)
  // Faculty review
  status          String   @default("pending")
  facultyFeedback String?
  marksAwarded    Int?
  submittedAt     DateTime @default(now())
  facultyReviewedAt DateTime?
  reviewedBy      String?

  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, reviewNumber])
  @@index([teamId])
  @@index([status])
}

model LiveSession {
  id          String   @id @default(cuid())
  title       String
  description String?
  sessionDate DateTime
  dayOfWeek   String   // "Sunday" | "Monday"
  startTime   String
  endTime     String
  meetingUrl  String
  meetingType String   @default("google_meet")
  createdAt   DateTime @default(now())

  @@index([sessionDate])
}
